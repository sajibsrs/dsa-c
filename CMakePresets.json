{
    "version": 8,
    "configurePresets": [
        {
            "name": "gcc",
            "displayName": "Homebrew GCC 15.1.0",
            "description": "Using compilers: C = gcc 15, CXX = g++ 15",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/opt/homebrew/bin/aarch64-apple-darwin25-gcc-15",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
